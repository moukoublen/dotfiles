[alias]
	s = status --short --branch
	h = log --pretty=format:\"%C(yellow)%h%C(reset) %C(blue)%<(28)%an%C(reset) %C(dim)%as%C(reset) %s %C(bold red)%d%C(reset)\"
	f = fetch --all --prune

	# Use fzf to switch branch
	b = "!f() { git checkout ${1:-$(git for-each-ref refs/heads/ --format='%(refname:short)' | fzf)}; }; f"

	# --force-with-lease    Only force-push if the remote branch is exactly what I think it is.
	# --force-if-includes   Only force-push if my local history already includes the remote commits.
	fp = push --force-if-includes --force-with-lease

[init]
	defaultBranch = main

[commit]
	gpgsign = true

# %<(N) → left-align, pad to N chars
# %>(N) → right-align
# %<(N,trunc) → truncate if too long
# %<(N,ltrunc) → truncate from left

[tag]
	sort = -version:refname
[url "git@github.com:"]
	insteadOf = https://github.com/
[pull]
	ff = only

[core]
	editor = vim
	pager = delta
[interactive]
	diffFilter = delta --color-only --features=interactive
[delta]
	dark = true
	navigate = true
	line-numbers = true
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[color "diff"]
	whitespace = red reverse
# https://dandavison.github.io/delta/configuration.html
# https://github.com/dandavison/delta
# https://dandavison.github.io/delta/
